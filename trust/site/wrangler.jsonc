{
  // Agent Trust Score leaderboard: static assets only, no bindings, no secrets.
  // Deploy with `wrangler deploy` from this directory.
  "name": "agent-trust",
  "compatibility_date": "2026-10-01",
  // Custom domain on the hibari.digital zone (same Cloudflare account); DNS + cert are managed by the deploy.
  "workers_dev": true,
  "routes": [{ "pattern": "trust.hibari.digital", "custom_domain": true }],
  "assets": {
    "directory": "./",
    "not_found_handling": "none"
  }
}
